# Required — copy this to .env and fill in your values
# Never commit the actual .env file

# Supabase PostgreSQL connection string
# Supabase dashboard → Settings → Database → Connection String (URI mode)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Secret for signing JWT tokens — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here"

# Port for the Express server (default: 3001)
PORT=3001

# Frontend URL for CORS — change to your Vercel URL in production
CORS_ORIGIN="http://localhost:5173"

# Node environment
NODE_ENV="development"
