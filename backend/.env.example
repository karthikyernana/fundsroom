# Required — copy this to .env and fill in your values
# Never commit the actual .env file

# Supabase PostgreSQL connection strings (from Supabase Dashboard → Connect → ORM → Prisma)
DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Dedicated database used only by `npm test`. The integration suite clears all
# application tables before it runs, so never point this at local or production data.
TEST_DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/fundsroom_test"


# Secret for signing JWT tokens — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here"

# Port for the Express server (default: 3001)
PORT=3001

# Frontend URL for CORS — change to your Vercel URL in production
CORS_ORIGIN="http://localhost:5173"

# Node environment
NODE_ENV="development"
