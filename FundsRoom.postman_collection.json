{
  "info": {
    "_postman_id": "fundsroom-mini-erp-crm",
    "name": "FundsRoom Mini ERP + CRM API",
    "description": "Postman Collection for FundsRoom Mini ERP + CRM Operations Portal REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundsroom.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Get Sales Representatives (/auth/sales-reps)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sales-reps",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sales-reps"]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "active", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Engineering Ltd\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"procurement@apexeng.com\",\n  \"business_name\": \"Apex Engineering Ltd\",\n  \"gst_number\": \"27AABCA1234A1Z5\",\n  \"customer_type\": \"wholesale\",\n  \"address\": \"Plot 42, MIDC Industrial Area, Pune, Maharashtra 411026\",\n  \"status\": \"lead\",\n  \"notes\": \"Initial inquiry for bulk bearing supply\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"notes\": \"Converted from lead after credit verification\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Add Customer Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed quarterly pricing. Sent sample catalog.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id/notes",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id", "notes"],
              "variable": [{ "key": "id", "value": "CUSTOMER_UUID_HERE" }]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "low_stock", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Deep Groove Ball Bearing 6205-2RS\",\n  \"sku\": \"BRG-6205-2RS\",\n  \"category\": \"Bearings\",\n  \"unit_price\": 350.00,\n  \"current_stock\": 100,\n  \"min_stock_alert\": 15,\n  \"location\": \"Rack A-04\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_price\": 375.00,\n  \"min_stock_alert\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Record Stock Movement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity_changed\": 50,\n  \"movement_type\": \"IN\",\n  \"reason\": \"Received fresh shipment PO-2026-088\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id/stock-movements",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "stock-movements"],
              "variable": [{ "key": "id", "value": "PRODUCT_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Get Stock Movement History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id/stock-movements",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id", "stock-movements"],
              "variable": [{ "key": "id", "value": "PRODUCT_UUID_HERE" }]
            }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "List Challans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "draft", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Challan (Draft)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"CUSTOMER_UUID_HERE\",\n  \"items\": [\n    {\n      \"product_id\": \"PRODUCT_UUID_HERE\",\n      \"quantity\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Get Challan",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Update Challan (Draft Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"PRODUCT_UUID_HERE\",\n      \"quantity\": 8\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Confirm Challan (Deducts Stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "confirm"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "cancel"],
              "variable": [{ "key": "id", "value": "CHALLAN_UUID_HERE" }]
            }
          }
        }
      ]
    }
  ]
}
